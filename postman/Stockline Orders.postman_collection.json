{
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7375"
    },
    {
      "key": "orderId",
      "value": "ORD-1048"
    }
  ],
  "info": {
    "name": "Stockline Orders - Lesson 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Order - two units",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "pm.collectionVariables.set(\"orderId\", order.id);",
              "pm.test(\"2 unit(s): expected USD 3.98\", () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(order.total).to.eql(3.98);",
              "  pm.expect(order.currency).to.eql(\"USD\");",
              "  pm.expect(order.status).to.eql(\"Confirmed\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Order - one unit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "pm.collectionVariables.set(\"orderId\", order.id);",
              "pm.test(\"1 unit(s): expected USD 1.99\", () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(order.total).to.eql(1.99);",
              "  pm.expect(order.currency).to.eql(\"USD\");",
              "  pm.expect(order.status).to.eql(\"Confirmed\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Order - three units",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const order = pm.response.json();",
              "pm.collectionVariables.set(\"orderId\", order.id);",
              "pm.test(\"3 unit(s): expected USD 5.97\", () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(order.total).to.eql(5.97);",
              "  pm.expect(order.currency).to.eql(\"USD\");",
              "  pm.expect(order.status).to.eql(\"Confirmed\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Last Order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders/{{orderId}}"
      }
    },
    {
      "name": "Reject zero quantity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Zero quantity is rejected\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
