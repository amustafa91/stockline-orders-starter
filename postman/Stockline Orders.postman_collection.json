{
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7375"
    },
    {
      "key": "orderId",
      "value": "ORD-1048"
    }
  ],
  "info": {
    "name": "Stockline Orders - Course",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const order = pm.response.json();",
              "pm.collectionVariables.set(\"orderId\", order.id);",
              "pm.test(\"Known checkout response\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 202, 409]);",
              "  pm.expect(order.total).to.eql(24);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "url": "{{baseUrl}}/orders",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw",
          "raw": "{\"quantity\":2}"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "method": "POST"
      },
      "name": "Create Order"
    },
    {
      "name": "Get Last Order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders/{{orderId}}"
      }
    }
  ]
}
