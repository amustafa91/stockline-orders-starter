            {
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const order = pm.response.json();",
                      "pm.collectionVariables.set(\"lesson01OrderId\", order.id);",
                      "pm.test(\"Known checkout response\", () => {",
                      "  pm.expect(pm.response.code).to.be.oneOf([201, 202, 409]);",
                      "  pm.expect(order.total).to.eql(24);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "url": "{{baseUrl}}/orders",
                "body": {
                  "options": {
                    "raw": {
                      "language": "json"
